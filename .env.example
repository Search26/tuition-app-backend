# Copy to .env and change every value before deploying anywhere but your laptop.
APP_ENV=dev
# text (readable, dev) or json (one object per line, production).
LOG_FORMAT=text
LOG_LEVEL=INFO

POSTGRES_USER=tuition
POSTGRES_PASSWORD=change-me-postgres
POSTGRES_DB=tuition
# Inside Compose the host is "postgres"; use localhost:5432 when running tools on the host.
DATABASE_URL=postgresql+asyncpg://tuition:change-me-postgres@postgres:5432/tuition
# Used by pytest; the database is created by docker/postgres/init-test-db.sql.
TEST_DATABASE_URL=postgresql+asyncpg://tuition:change-me-postgres@postgres:5432/tuition_test

REDIS_URL=redis://redis:6379/0
# Used by pytest, so tests never share a queue with the worker.
TEST_REDIS_URL=redis://redis:6379/1

MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=tuition-minio
MINIO_SECRET_KEY=change-me-minio-secret
MINIO_SECURE=false
MINIO_REGION=us-east-1
MINIO_BUCKET=tuition-media
# Presigned upload URLs are signed for this host:port, so it must be what the uploader reaches.
MINIO_PUBLIC_ENDPOINT=localhost:9000
MINIO_PUBLIC_SECURE=false

# Video upload: max source size (2 GB) and presigned URL lifetime (15 minutes).
UPLOAD_MAX_BYTES=2147483648
UPLOAD_URL_TTL_SECONDS=900

# Transcode worker: jobs at once, per-attempt ffmpeg timeout, ffmpeg threads (0 = auto),
# temp dir for source and output, delay before the one automatic retry.
WORKER_MAX_JOBS=1
TRANSCODE_TIMEOUT_SECONDS=3600
TRANSCODE_THREADS=0
TRANSCODE_TMP_DIR=/tmp
TRANSCODE_RETRY_DELAY_SECONDS=30

HEALTH_CHECK_TIMEOUT_SECONDS=2

# At least 32 characters. Generate one with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-jwt-secret-at-least-32-characters
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30

# Login rate limit: attempts per IP per window, failed logins per email per window.
LOGIN_IP_LIMIT=20
LOGIN_IP_WINDOW_SECONDS=60
LOGIN_EMAIL_FAILURE_LIMIT=5
LOGIN_EMAIL_WINDOW_SECONDS=900

# Public prefix of nginx's /media/ location; signed media URLs start with it.
MEDIA_BASE_URL=http://localhost:8080/media
# Signs /media/ URLs (nginx checks every playlist and segment). Not the JWT secret.
MEDIA_SIGNING_SECRET=change-me-media-signing-secret-32-chars-min
MEDIA_URL_TTL_SECONDS=14400
MEDIA_THUMBNAIL_TTL_SECONDS=86400
# Progress sync: client timestamps further ahead than this are clamped to server time (1 day).
PROGRESS_MAX_CLOCK_SKEW_SECONDS=86400
# Browser origins for dev web pages (comma-separated).
CORS_ORIGINS=http://localhost:3000
