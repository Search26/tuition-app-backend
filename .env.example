# Copy to .env and change every value before deploying anywhere but your laptop.
APP_ENV=dev

POSTGRES_USER=tuition
POSTGRES_PASSWORD=change-me-postgres
POSTGRES_DB=tuition
# Inside Compose the host is "postgres"; use localhost:5432 when running tools on the host.
DATABASE_URL=postgresql+asyncpg://tuition:change-me-postgres@postgres:5432/tuition
# Used by pytest; the database is created by docker/postgres/init-test-db.sql.
TEST_DATABASE_URL=postgresql+asyncpg://tuition:change-me-postgres@postgres:5432/tuition_test

REDIS_URL=redis://redis:6379/0

MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=tuition-minio
MINIO_SECRET_KEY=change-me-minio-secret
MINIO_SECURE=false

HEALTH_CHECK_TIMEOUT_SECONDS=2
