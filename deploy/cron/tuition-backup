# Nightly backup of the tuition stack. Install with:
#   sudo cp deploy/cron/tuition-backup /etc/cron.d/tuition-backup
# Assumes the repo is at /opt/tuition (docs/deploy.md). One JSON line per run in the log.
SHELL=/bin/bash
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
0 3 * * * root cd /opt/tuition && scripts/backup.sh >> /var/log/tuition-backup.log 2>&1
